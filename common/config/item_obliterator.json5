{
  // -----------------------------------------------------------
  //              Item Obliterator by ElocinDev
  // -----------------------------------------------------------
  //  
  // How to add items?
  //   - They are json strings, so you need to separate each
  //     entry with a comma, except the last
  //   - If you start an entry with !, it will be treated as a regular expression
  //     Example: "!minecraft:.*_sword" to disable all swords
  //  
  // -----------------------------------------------------------
  // Do not touch this
  "configVersion": 2,
  // -----------------------------------------------------------
  // Items here will be unusable completely
  //    Example: minecraft:diamond
  "blacklisted_items": [
    "!^createdeco:.*_sheet_metal$",
    "!^createdeco:.*_shipping_container$",
    "!^createmetalwork:.*_dust$",
    "!^dndecor:.*_boiler$",
    "!^dndecor:.*_catwalk$",
    "!^dndecor:.*container$",
    "!^mcwdoors:print_.*",
    "!^mcwtrpdoors:print_.*",
    "!^vintage:.*_curving_head$",
    "bits_n_bobs:test_rope",
    "brewinandchewin:kombucha",
    "create_aeronautics_automated_logistics:train_station",
    "create_aquatic_ambitions:calcium_rich_powder",
    "create_aquatic_ambitions:suspicious_rock",
    "create_connected:control_chip",
    "create_connected:fan_sanding_catalyst",
    "create:refined_radiance",
    "create:shadow_steel",
    "createaddition:brass_rod",
    "createaddition:digital_adapter",
    "createaddition:electrum_amulet",
    "createdeco:zinc_sheet",
    "createmetalwork:molten_aluminum_bucket",
    "createmetalwork:molten_bronze_bucket",
    "createmetalwork:molten_cast_iron_bucket",
    "createmetalwork:molten_lead_bucket",
    "createmetalwork:molten_lithium_bucket",
    "createmetalwork:molten_nickel_bucket",
    "createmetalwork:molten_osmium_bucket",
    "createmetalwork:molten_silver_bucket",
    "createmetalwork:molten_steel_bucket",
    "createmetalwork:molten_tin_bucket",
    "createmetalwork:molten_tungsten_bucket",
    "decorative_blocks:chain",
    "extra_gauges:linked_button",
    "extra_gauges:linked_lever",
    "farmersdelight:wheat_dough",
    "gnkinetics:chainable_cogwheel",
    "gnkinetics:cog_crank",
    "gnkinetics:large_cog_crank",
    "mcwroofs:rain_gutter",
    "minecraft:elytra",
    "society_trading:auto_trader",
    "sophisticatedbackpacks:advanced_mob_catcher_upgrade",
    "sophisticatedbackpacks:inception_upgrade",
    "sophisticatedbackpacks:infinity_upgrade",
    "sophisticatedbackpacks:mob_catcher_upgrade",
    "sophisticatedbackpacks:stack_upgrade_omega_tier",
    "sophisticatedbackpacks:survival_infinity_upgrade",
    "sophisticatedbackpacks:xp_pump_upgrade",
    "sophisticatedcore:ender_linker",
    "sophisticatedcore:xp_bucket",
    "vintage:andesite_rod",
    "vintage:andesite_sheet",
    "vintage:andesite_spring",
    "vintage:andesite_wire",
    "vintage:belt_grinder",
    "vintage:blaze_spring",
    "vintage:brass_spring",
    "vintage:brass_wire",
    "vintage:copper_spring",
    "vintage:copper_sulfate",
    "vintage:curving_press",
    "vintage:electrum_spring",
    "vintage:golden_spring",
    "vintage:grinder_belt",
    "vintage:iron_spring",
    "vintage:laser_item",
    "vintage:laser",
    "vintage:lathe",
    "vintage:netherite_rod",
    "vintage:netherite_wire",
    "vintage:recipe_card",
    "vintage:redstone_module",
    "vintage:small_andesite_spring",
    "vintage:small_brass_spring",
    "vintage:small_copper_spring",
    "vintage:small_electrum_spring",
    "vintage:small_golden_spring",
    "vintage:small_iron_spring",
    "vintage:small_netherite_spring",
    "vintage:small_vanadium_spring",
    "vintage:small_zinc_spring",
    "vintage:spring_coiling_machine_wheel",
    "vintage:spring_coiling_machine",
    "vintage:sulfur_block",
    "vintage:sulfur_chunk",
    "vintage:sulfur",
    "vintage:sulfuric_acid_bucket",
    "vintage:vacuum_chamber",
    "vintage:vanadium_block",
    "vintage:vanadium_ingot",
    "vintage:vanadium_nugget",
    "vintage:vanadium_rod",
    "vintage:vanadium_sheet",
    "vintage:vanadium_spring",
    "vintage:vanadium_wire",
    "vintage:zinc_rod",
    "vintage:zinc_sheet",
    "vintage:zinc_spring",
    "vintage:zinc_wire"
  ],
  // -----------------------------------------------------------
  // Removes an item if it contains certain nbt tag. If the whole entry (or expression) is present, the item gets removed.
  // Use with caution! This is a very expensive operation and can cause lag if you have a lot of items blacklisted.
  // 	
  // 	 Example to disable a regeneration potion: Potion:"minecraft:regeneration"
  // 	
  // 	 You can also use regular expressions by starting the value with !
  "blacklisted_nbt": [
    "potion:\"minecraft:luck\""
  ],
  // -----------------------------------------------------------
  // Items here will not be able to be right-clicked (Interact)
  //    Example: minecraft:apple
  "only_disable_interactions": [
    "examplemod:example_item"
  ],
  // -----------------------------------------------------------
  // Items here will not be able to be used to attack
  //    Example: minecraft:diamond_sword
  "only_disable_attacks": [
    "examplemod:example_item"
  ],
  // -----------------------------------------------------------
  // Items here will get their recipes disabled
  // Keep in mind this already is applied to blacklisted items
  "only_disable_recipes": [
    "examplemod:example_item"
  ],
  // -----------------------------------------------------------
  // If true, the mod will use a hashset to handle the blacklisted items
  // This is a more optimized approach only if you have a lot of items blacklisted (20 or more is recommended)
  // If you just have a small amount of items blacklisted, keep this false
  //  
  // [!] Enabling this will disable all regular expressions
  // [!] Does not apply to NBT, only item blacklist / interaction / attack
  "use_hashmap_optimizations": false
}